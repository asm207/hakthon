  },
  "components": {
    "schemas": {
      "AuditSummaryResponse": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "title": "Transaction Id"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          }
        },
        "type": "object",
        "required": [
          "transaction_id",
          "summary"
        ],
        "title": "AuditSummaryResponse"
      },
      "CreatePaymentRequest": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,10}|(?=[\\d.]{1,13}0*$)\\d{0,10}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Amount",
            "description": "Positive amount with at most 2 decimal places.",
            "examples": [
              "100.00"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "LYD",
              "USD",
              "EUR"
            ],
            "title": "Currency",
            "description": "ISO 4217 code (uppercase).",
            "examples": [
              "LYD"
            ]
          },
          "reference": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_\\-]+$",
            "title": "Reference",
            "description": "Merchant order reference.",
            "examples": [
              "ORDER-1001"
            ]
          },
          "simulation_mode": {
            "type": "string",
            "enum": [
              "force_success",
              "force_failure",
              "force_timeout"
            ],
            "title": "Simulation Mode",
            "description": "Controls the simulated outcome.",
            "default": "force_success"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "amount",
          "currency",
          "reference"
        ],
        "title": "CreatePaymentRequest"
      },
      "DebugRequest": {
        "properties": {
          "method": {
            "type": "string",
            "maxLength": 10,
            "title": "Method",
            "examples": [
              "POST"
            ]
          },
          "path": {
            "type": "string",
            "maxLength": 300,
            "title": "Path",
            "examples": [
              "/api/v1/payments"
            ]
          },
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Headers"
          },
          "body": {
            "title": "Body"
          },
          "response_status": {
            "type": "integer",
            "title": "Response Status"
          },
          "response_body": {
            "title": "Response Body"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "method",
          "path",
          "response_status"
        ],
        "title": "DebugRequest",
        "description": "A failed API call to be analysed by Gemini."
      },
      "DebugSuggestion": {
        "properties": {
          "problem": {
            "type": "string",
            "title": "Problem"
          },
          "cause": {
            "type": "string",
            "title": "Cause"
          },
          "fix": {
            "type": "string",
            "title": "Fix"
          },
          "corrected_payload": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corrected Payload",
            "description": "Corrected JSON body as a string, if relevant."
          }
        },
        "type": "object",
        "required": [
          "problem",
          "cause",
          "fix"
        ],
        "title": "DebugSuggestion"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PaymentResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "object": {
            "type": "string",
            "const": "payment",
            "title": "Object",
            "default": "payment"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "reference": {
            "type": "string",
            "title": "Reference"
          },
          "simulation_mode": {
            "type": "string",
            "title": "Simulation Mode"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "success",
              "failed",
              "timeout",
              "refunded"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "refunded_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refunded At"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/StatusChange"
            },
            "type": "array",
            "title": "History"
          }
        },
        "type": "object",
        "required": [
          "id",
          "amount",
          "currency",
          "reference",
          "simulation_mode",
          "status",
          "created_at",
          "updated_at",
          "refunded_at",
          "history"
        ],
        "title": "PaymentResponse"
      },
      "SmokeStep": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped"
            ],
            "title": "Status"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "name",
          "status",
          "duration_ms",
          "detail"
        ],
        "title": "SmokeStep"
      },
      "SmokeTestResponse": {
        "properties": {
          "passed": {
            "type": "boolean",
            "title": "Passed"
          },
          "transaction_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transaction Id"
          },
          "total_ms": {
            "type": "integer",
            "title": "Total Ms"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/SmokeStep"
            },
            "type": "array",
            "title": "Steps"
          }
        },
        "type": "object",
        "required": [
          "passed",
          "transaction_id",
          "total_ms",
          "steps"
        ],
        "title": "SmokeTestResponse"
      },
      "StatusChange": {
        "properties": {
          "from_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "From Status"
          },
          "to_status": {
            "type": "string",
            "title": "To Status"
          },
          "event": {
            "type": "string",
            "title": "Event"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          }
        },
        "type": "object",
        "required": [
          "from_status",
          "to_status",
          "event",
          "at"
        ],
        "title": "StatusChange"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Merchant API key, e.g. sk_test_...",
        "scheme": "bearer"
      }
    }
  },
  "servers": [
    {
      "url": "https://127.0.0.1:8000",
      "description": "Local sandbox (HTTPS)"
    }
  ]
}