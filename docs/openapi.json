              "title": "Idempotency-Key"
            },
            "description": "Unique key per operation (e.g. a UUID). Repeating it returns the original response."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
