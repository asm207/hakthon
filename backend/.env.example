# Copy this file to .env and fill in the values.

# PostgreSQL connection: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/paysim

# Google AI Studio key (https://aistudio.google.com/apikey). Leave empty to disable AI features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Frontend origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,https://localhost:5173

# Max requests per minute per API key
RATE_LIMIT=60/minute

# Simulation timings in seconds
SIM_PROCESSING_DELAY=1
SIM_OUTCOME_DELAY=2
SIM_TIMEOUT_DELAY=8

# TLS verification for the smoke-test endpoint calling this same server.
# "true" = normal verification, "false" = skip (local self-signed only), or a path to a CA file.
SMOKE_TLS_VERIFY=true
